const uint8_t ANIM_SEGMENT_COUNT = sizeof(ANIM_SEGMENTS) / sizeof(ANIM_SEGMENTS[0]);

// Dinlenme/'karsıya bakan' yuz artik animasyon karelerinden degil, kullanicinin
// gonderdigi ozel idleFaceBitmap gorselinden gosteriliyor (asagida drawIdleFaceBitmap).

// ---- Chronos'un loop() icinde de calismaya devam etmesi icin 'akilli delay' -
// delay() yerine bunu kullaniyoruz: bekleme suresince watch.loop() surekli
// cagrilir, boylece BLE baglantisi kopmaz / bildirimler & navigasyon anlik
// yakalanir. Ayrica yuksek onceligi bir olay (navigasyon acilmasi ya da yeni
// bildirim) geldiginde bekleme erken kesilip true doner.
bool smartDelay(uint32_t ms) {
    uint32_t start = millis();
    while (millis() - start < ms) {
        watch.loop();
        if (watch.getNavigation().active) return true;
        if (notificationPending) return true;
        handleTouchWhileAwake();
        if (isAsleep) return true; // 2 sn'lik sabit temas ile uykuya gecildi
        delay(5);
    }
    return false;
}

// ---- Bir kareyi ekrana ciz (mochi animasyon karesi) ------------------------
void drawAnimFrame(uint8_t frameIndex) {
    display.clearDisplay();
    for (uint16_t y = 0; y < mochiFaceGif.height; y++) {
        for (uint16_t x = 0; x < mochiFaceGif.width; x++) {
            uint16_t byteIndex = y * ((mochiFaceGif.width + 7) / 8) + (x / 8);
            uint8_t  bitIndex  = 7 - (x % 8);
            uint8_t  b = pgm_read_byte(&(mochiFaceGif.frames[frameIndex][byteIndex]));
            if (b & (1 << bitIndex)) {
                display.drawPixel(x, y, SSD1306_WHITE);
            }
        }
    }
    display.display();
}

// ---- Kullanicinin gonderdigi idle-yuz gorselini ekrana ciz -----------------
// idleFaceBitmap dogrudan 128x64/1024 byte oldugu icin mochiFaceGif yapisina
// ihtiyac duymadan, drawAnimFrame ile ayni bit duzenini kullanarak ciziyoruz.
void drawIdleFaceBitmap() {
    display.clearDisplay();
    for (uint16_t y = 0; y < SCREEN_HEIGHT; y++) {
        for (uint16_t x = 0; x < SCREEN_WIDTH; x++) {
            uint16_t byteIndex = y * (SCREEN_WIDTH / 8) + (x / 8);
            uint8_t  bitIndex  = 7 - (x % 8);
            uint8_t  b = pgm_read_byte(&(idleFaceBitmap[byteIndex]));
            if (b & (1 << bitIndex)) {
                display.drawPixel(x, y, SSD1306_WHITE);
            }
        }
    }
    display.display();
}

// ---- Secilen turun tum karelerini orijinal delay'leriyle oynat ------------
// Yuksek oncelikli bir olay gelirse (navigasyon / bildirim) segmenti yarida
// kesip true doner; normal bitisse false doner.
bool playSegment(const AnimSegment &seg) {
    for (uint8_t i = 0; i < seg.frameCount; i++) {
        uint8_t globalFrame = seg.startFrame + i;
        drawAnimFrame(globalFrame);
        if (smartDelay(animDelays[globalFrame])) return true;
    }
    return false;
}

// ---- Animasyon sonrasi 5 sn 'karsiya bakan' dinlenme yuzu ------------------
// Kullanicinin gonderdigi idleFaceBitmap gorseli gosterilir (hicbir kirpma
// yapilmadan, en boy orani korunarak 128x64'e sigdirilmis haldeki gorsel).
bool showIdleFace(uint32_t ms) {
    drawIdleFaceBitmap();
    return smartDelay(ms);
}

// ============================================================================
// ---- Pin 18: cift tiklama ile uyanma / 2 sn sabit temas ile uykuya gecis ---
// ============================================================================

// ---- Ekrani + BLE'yi kapatip hafif uykuya gecis ----------------------------
void enterSleep() {
    Serial.println(F("2 sn sabit temas algilandi -> ekran ve BLE kapatiliyor, uykuya geciliyor"));

    // ekrani kapat
    display.clearDisplay();
    display.display();
    display.ssd1306_command(SSD1306_DISPLAYOFF);

    // bluetooth'u tamamen kapat
    NimBLEDevice::deinit(true);

    // parmak/temas birakilana kadar bekle, yoksa hemen ayni temasla geri uyanir
    while (digitalRead(TOUCH_PIN) == HIGH) {
        delay(20);
    }

    isAsleep          = true;
    touchPrevState     = false;
    holdSleepTriggered = false;
    lastTapAtAsleep    = 0;
}

// ---- Ekrani + BLE'yi tekrar acip normal calismaya donus --------------------
void wakeUpDevice() {
    Serial.println(F("Cift tiklama algilandi -> ekran ve BLE aciliyor"));

    display.ssd1306_command(SSD1306_DISPLAYON);

    // BLE / Chronos'u yeniden baslat
    watch.begin();
    watch.setBattery(100);

    isAsleep       = false;
    touchPrevState = false;
}

// ---- Uykudayken: hafif uykuda bekle, pin 18'de temas gelince cift tiklama
//      olup olmadigina bak (iki vurus DOUBLE_TAP_WINDOW_MS icinde gelirse
//      cift tiklama sayilir ve cihaz uyanir). --------------------------------
void handleSleepMode() {
    // pin 18 HIGH oldugunda hafif uykudan uyanacak sekilde kur
    esp_sleep_enable_gpio_wakeup();
    gpio_wakeup_enable((gpio_num_t)TOUCH_PIN, GPIO_INTR_HIGH_LEVEL);
    esp_light_sleep_start();
    gpio_wakeup_disable((gpio_num_t)TOUCH_PIN);

    if (digitalRead(TOUCH_PIN) != HIGH) {
        return; // baska bir sebeple uyandiysa (or. zamanlayici) yoksay
    }

    uint32_t tapAt = millis();

    // bu vurusun birakilmasini bekle
    while (digitalRead(TOUCH_PIN) == HIGH) {
        delay(5);
    }

    if (lastTapAtAsleep != 0 && (tapAt - lastTapAtAsleep) <= DOUBLE_TAP_WINDOW_MS) {
        // ikinci vurus zaman penceresi icinde geldi -> cift tiklama
        wakeUpDevice();
        lastTapAtAsleep = 0;
    } else {
        // ilk vurus (ya da pencere disinda kalan tek vurus) -> zaman damgasini tut
        lastTapAtAsleep = tapAt;
    }
}

// ---- Uyanikken: pin 18'e 2 sn kesintisiz (sabit) temas edilirse uykuya
//      gecis tetiklenir. Kisa/tekli dokunuslar burada bir sey yapmaz;
//      cift tiklamanin islevi sadece uykudan uyanmaktir. ---------------------
void handleTouchWhileAwake() {
    bool state = (digitalRead(TOUCH_PIN) == HIGH);

    if (state && !touchPrevState) {
        // yeni temas basladi
        touchDownAt        = millis();
        holdSleepTriggered = false;
    }

    if (state && !holdSleepTriggered && (millis() - touchDownAt >= HOLD_TO_SLEEP_MS)) {
        holdSleepTriggered = true;
        enterSleep();
        return;
    }

    touchPrevState = state;
}

// ---- Rastgele bir tur sec (ust uste ayni turu tekrar etmemeye calisir) ----
uint8_t pickRandomSegment() {
    static int8_t lastPicked = -1;
    uint8_t idx;
    do {
        idx = random(0, ANIM_SEGMENT_COUNT);
    } while (ANIM_SEGMENT_COUNT > 1 && idx == lastPicked);
    lastPicked = idx;
    return idx;
}

// ============================================================================
// ---- GUI yardimcilari (kucuk cizim primitifleriyle, 128x64 mono) ---
// ============================================================================

// Basit kelime kaydirma: verilen genislige (piksel) gore metni satirlara boler
void drawWrappedText(const String &text, int16_t x, int16_t y, uint8_t textSize,
                      uint16_t maxWidth, uint8_t maxLines) {
    display.setTextSize(textSize);
    display.setTextColor(SSD1306_WHITE);
    uint8_t charW = 6 * textSize; // Adafruit_GFX varsayilan font genisligi
    uint8_t charsPerLine = maxWidth / charW;
    if (charsPerLine < 1) charsPerLine = 1;

    String remaining = text;
    uint8_t line = 0;
    while (remaining.length() > 0 && line < maxLines) {
        String chunk;
        if (remaining.length() <= charsPerLine) {
            chunk = remaining;
            remaining = "";
        } else {
            int breakAt = remaining.lastIndexOf(' ', charsPerLine);
            if (breakAt <= 0) breakAt = charsPerLine;
            chunk = remaining.substring(0, breakAt);
            remaining = remaining.substring(breakAt);
            remaining.trim();
        }
        display.setCursor(x, y + line * (8 * textSize + 2));
        display.print(chunk);
        line++;
    }
}

// ---- Bildirim karti: uygulama adi + baslik + mesaj + geri sayim cubugu ----
void drawNotificationCard(const Notification &n, uint32_t elapsedMs) {
    display.clearDisplay();
    display.drawRoundRect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, 6, SSD1306_WHITE);

    // ust satir: kucuk "bildirim" ikonu (zil) + uygulama adi
    display.fillCircle(10, 10, 4, SSD1306_WHITE);
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(20, 6);
    display.print(n.app.length() ? n.app : String("Bildirim"));
    display.drawFastHLine(4, 16, SCREEN_WIDTH - 8, SSD1306_WHITE);

    // baslik (biraz daha vurgulu: iki kez yan yana ofsetli yazip kalin efekti)
    display.setCursor(5, 20);
    display.print(n.title);
    display.setCursor(6, 20);
    display.print(n.title);

    // mesaj (kaydirmali, en fazla 2 satir)
    drawWrappedText(n.message, 5, 32, 1, SCREEN_WIDTH - 10, 2);

    // alt kisimda geri sayim cubugu (10 sn icinde azalir)
    uint16_t barMaxW = SCREEN_WIDTH - 10;
    uint16_t remainMs = (elapsedMs >= NOTIF_DISPLAY_MS) ? 0 : (NOTIF_DISPLAY_MS - elapsedMs);
    uint16_t barW = (uint32_t)barMaxW * remainMs / NOTIF_DISPLAY_MS;
    display.drawRoundRect(5, 56, barMaxW, 5, 2, SSD1306_WHITE);
    if (barW > 2) display.fillRoundRect(5, 56, barW, 5, 2, SSD1306_WHITE);

    display.display();
}

// ---- Google Maps / OSMAnd navigasyon ikonunu (48x48, Chronos'tan gelen) ---
// ---- doğrudan Chronos'un gonderdigi GERCEK ikon verisiyle cizer -----------
void drawNavIcon(const Navigation &nav, int16_t ox, int16_t oy) {
    if (!nav.hasIcon) {
        // ikon henuz gelmediyse basit bir ok ciz (yer tutucu)
        display.fillTriangle(ox + 24, oy, ox, oy + 40, ox + 48, oy + 40, SSD1306_WHITE);
        return;
    }
    for (int y = 0; y < 48; y++) {
        for (int x = 0; x < 48; x++) {
            int byteIndex = (y * 48 + x) / 8;
            int bitPos = 7 - (x % 8);
            bool pixelOn = (nav.icon[byteIndex] >> bitPos) & 0x01;
            if (pixelOn) display.drawPixel(ox + x, oy + y, SSD1306_WHITE);
        }
    }
}

// ---- Navigasyon karti: gercek Maps ikonu + mesafe/sure/ETA + yol tarifi ---
void drawNavigationCard(const Navigation &nav) {
    display.clearDisplay();
    display.drawRoundRect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, 6, SSD1306_WHITE);

    // sol: Google Maps / OSMAnd'in gonderdigi gercek yon ikonu (48x48 -> ekrana sigdirilmis)
    drawNavIcon(nav, 2, 8);
    display.drawFastVLine(54, 2, SCREEN_HEIGHT - 4, SSD1306_WHITE);

    // sag ust: mesafe (buyuk) + sure/ETA (kucuk)
    display.setTextSize(2);
    display.setCursor(60, 4);
    display.print(nav.distance);

    display.setTextSize(1);
    display.setCursor(60, 22);
    display.print(nav.duration);
    display.setCursor(60, 32);
    display.print(F("ETA "));
    display.print(nav.eta);

    // alt satir: sokak / yon tarifi metni tum genislikte kaydirmali
    display.drawFastHLine(0, 44, SCREEN_WIDTH, SSD1306_WHITE);
    drawWrappedText(nav.directions, 3, 47, 1, SCREEN_WIDTH - 6, 2);

    display.display();
}

// ============================================================================
// ---- Chronos geri cagirimlari (callback) -----------------------------------
// ============================================================================

void connectionCallback(bool state) {
    Serial.println(state ? F("Chronos: telefon baglandi") : F("Chronos: baglanti koptu"));
}

void notificationCallback(Notification notification) {
    currentNotification = notification;
    notificationPending  = true;
    notificationShownAt  = millis();
    Serial.print(F("Yeni bildirim: "));
    Serial.println(notification.title);
}

void configurationCallback(Config config, uint32_t a, uint32_t b) {
    if (config == CF_NAV_DATA) {
        Serial.println(F("Navigasyon durumu guncellendi"));
    }
}

// ============================================================================
void setup() {
    Serial.begin(115200);

    Wire.begin(SDA_PIN, SCL_PIN); // ESP32-C6 Super Mini: pinleri elle veriyoruz
    if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
        Serial.println(F("SSD1306 baslatilamadi"));
        for (;;);
    }

    randomSeed(esp_random()); // C6 donanim RNG'si - pine bagli degil, gercek rastgele

    // Pin 18: harici dokunmatik sensor modulunun (temassiz=LOW, temasli=HIGH)
    // dijital cikisi. Modulunuz ters mantikta ise (temassiz=HIGH) buradaki ve
    // handleTouchWhileAwake/handleSleepMode icindeki HIGH kontrollerini LOW ile
    // degistirin.
    pinMode(TOUCH_PIN, INPUT);

    // Chronos / BLE kurulumu (ESP32-C3 / ESP32-S3)
    watch.setConnectionCallback(connectionCallback);
    watch.setNotificationCallback(notificationCallback);
    watch.setConfigurationCallback(configurationCallback);
    watch.begin();
    watch.setBattery(100);

    display.clearDisplay();
    display.display();
}

void loop() {
    // 0) ONCELIK: Cihaz uykudaysa (ekran+BLE kapali), sadece pin 18'deki
    //    cift tiklamayi beklemek icin hafif uykuda kal.
    if (isAsleep) {
        handleSleepMode();
        return;
    }

    watch.loop();
    handleTouchWhileAwake(); // 2 sn sabit temas -> uykuya gecis kontrolu
    if (isAsleep) return;    // enterSleep() bu turda tetiklendiyse hemen cik

    // 1) ONCELIK: Google Maps / OSMAnd navigasyonu Chronos uzerinden aktifse,
    //    navigasyon bitene kadar modern navigasyon karti gosterilir.
    Navigation nav = watch.getNavigation();
    if (nav.active) {
        drawNavigationCard(nav);
        watch.loop();
        handleTouchWhileAwake();
        delay(150); // Chronos ekran guncellemesini asiri hizli yeniden cizmeden takip et
        return;
    }

    // 2) ONCELIK: Yeni bir bildirim geldiyse, 10 saniye boyunca kart GUI'si.
    if (notificationPending) {
        uint32_t elapsed = millis() - notificationShownAt;
        if (elapsed >= NOTIF_DISPLAY_MS) {
            notificationPending = false;
        } else {
            drawNotificationCard(currentNotification, elapsed);
            watch.loop();
            handleTouchWhileAwake();
            delay(100);
            return;
        }
    }

    // 3) Normal akis: rastgele bir mochi animasyon turu oynat, ardindan
    //    5 saniye "karsiya bakan" dinlenme yuzunu goster.
    uint8_t segIdx = pickRandomSegment();
    const AnimSegment &seg = ANIM_SEGMENTS[segIdx];

    Serial.print(F("Oynatilan animasyon turu: "));
    Serial.println(seg.name);

    if (playSegment(seg)) return;   // navigasyon/bildirim araya girdiyse dongu basa doner
    showIdleFace(IDLE_FACE_MS);
}
