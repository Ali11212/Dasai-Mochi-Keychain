// ============================================================================
// mochiFace_animations.ino
//
// Acıklama:
//   1) Chronos app baglantisi (ChronosESP32 kutuphanesi, BLE).
//      - Gelen bildirim -> 20 sn boyunca modern kart GUI'siyle goruntulenir.
//      - Google Maps / OSMAnd navigasyonu Chronos uzerinden aktifken,
//        uygulamanin gonderdigi GERCEK yon ikonu + mesafe/sure/ETA/tarif
//        bir kart GUI'siyle goruntulenir (navigasyon bitene kadar).
//   2) Her mochi animasyon turu oynadiktan SONRA 3 saniye boyunca, mevcut
//      kare setinden secilen duz-bakan/sade 66. kare 'dinlenme
//      yuzu' olarak gosterilir.
//
// Kullanilan karta OZEL kutuphaneler (Arduino Kutuphane Yoneticisi'nden kur):
//   - Adafruit GFX Library
//   - Adafruit SSD1306
//   - ChronosESP32          (fbiego/chronos-esp32)
//   - NimBLE-Arduino        (ChronosESP32'nin bagimliligi)
//   - ESP32Time             (ChronosESP32'nin bagimliligi)
//
// Kart: ESP32-C6 Super Mini (BLE gerektigi icin klasik Uno/Nano OLMAZ).
// Chronos app'te: Watches sekmesi > Pair New Devices > bu karti sec.
//
// ESP32-C6 ICIN ONEMLI NOTLAR:
//   - NimBLE-Arduino MUTLAKA v2.5.1 veya ustu olmali. C6 kullanılmalı
//     NimBLE-Arduino'ya ancak 2.5.x surumunde eklendi; eski 1.4.x surumler
//     C6'da DERLENMEZ / BLE calismaz. Kutuphane Yoneticisi'nden guncelleyin.
//   - Arduino-ESP32 core en az 3.x olmali (Boards Manager'dan 'esp32 by
//     Espressif Systems' paketini guncelleyin, kart olarak 'ESP32C6 Dev
//     Module' secin).
//   - 'Super Mini' klonlarinin I2C pin yerlesimi UretIciye gore DEGISIR
//     (bazilarinda SDA=GPIO9/SCL=GPIO10, bazilarinda SDA=GPIO20/SCL=GPIO19).
//     Asagidaki SDA_PIN / SCL_PIN degerlerini kendi karti/uzerindeki
//     serigrafiye gore MUTLAKA kontrol edip gerekirse degistirin.
//   - C6'da sabit bir 'A0' analog pini tanimli olmayabilir; bu yuzden random
//     tohumlamasi analogRead yerine cipin donanim RNG'siyle (esp_random)
//     yapiliyor.
// ============================================================================

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <ChronosESP32.h>
#include <esp_random.h>
#include <esp_sleep.h>
#include <driver/gpio.h>
#include <NimBLEDevice.h>   // BLE'yi tamamen acip kapatmak icin (ChronosESP32'nin bagimliligi)

// ---- Ekran ayarlari (gerekirse kendi donaniminiza gore degistirin) --------
#define SCREEN_WIDTH   128
#define SCREEN_HEIGHT  64
#define OLED_RESET     -1
#define SCREEN_ADDRESS 0x3C

// ESP32-C6 Super Mini I2C pinleri - KARTINIZIN SERIGRAFISINE GORE DOGRULAYIN!
#define SDA_PIN 19
#define SCL_PIN 20
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ---- Chronos (ESP32-C3 / ESP32-S3 BLE) -------------------------------------
ChronosESP32 watch("Dasai Mochi");

volatile bool     notificationPending  = false;
uint32_t          notificationShownAt  = 0;
const uint32_t    NOTIF_DISPLAY_MS     = 20000; // istenen: 20 saniye
Notification      currentNotification;

const uint32_t    IDLE_FACE_MS         = 3000;  // istenen: 3 saniye

// ---- PIN 18 DOKUNMA / UYKU KONTROLU ----------------------------------------
// NOT: ESP32-C6'da klasik ESP32'deki gibi donanimsal touchRead() (kapasitif
// dokunma) BULUNMAZ. Bu yuzden burada pin 18'e baglanan HARICI bir dokunmatik
// sensor modulu (orn. TTP223) varsayilir: modul dokunulunca HIGH, birakilinca
// LOW verir. Dogrudan bir metal pad/tel + parmakla ADC tabanli algilama
// istiyorsaniz bu kod parcasini kendi yonteminize gore uyarlamaniz gerekir.
//
// ONEMLI GUC/DAVRANIS NOTU: Gercek derin uyku (esp_deep_sleep_start) cipi
// SIFIRLAR; CPU calismadigi icin "cift tiklama" gibi bir sayma islemini
// donanimsal olarak ayirt edemez (sadece tek bir seviye/kenar tetigiyle
// uyanabilir). Bu yuzden burada esp_light_sleep_start() kullaniliyor: ekran
// ve BLE tamamen elle kapatiliyor (guc tuketimi cok dusuyor) ama CPU ve RAM
// canli kaldigi icin cift tiklamayi YAZILIMLA dogru sekilde sayabiliyoruz.
#define TOUCH_PIN 18

const uint32_t DOUBLE_TAP_WINDOW_MS = 500;   // iki vurus arasi izin verilen max sure
const uint32_t HOLD_TO_SLEEP_MS     = 2000;  // kesintisiz (sabit) temas suresi -> uykuya gecis

bool     isAsleep           = false;  // true: ekran+BLE kapali, hafif uykuda
bool     touchPrevState     = false;  // bir onceki loop turundaki temas durumu
uint32_t touchDownAt        = 0;      // temasin basladigi an (awake modda)
bool     holdSleepTriggered = false;  // bu temasta zaten uykuya gecildi mi
uint32_t lastTapAtAsleep    = 0;      // uykudayken algilanan ilk vurusun zamani

// ---- GIF veri yapisi --------------------------------------------------------
typedef struct {
    const uint8_t  frame_count;
    const uint16_t width;
    const uint16_t height;
    const uint16_t* delays;
    const uint8_t (*frames)[1024];
} AnimatedGIF;

